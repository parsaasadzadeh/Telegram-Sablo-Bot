{
  "name": "sablo-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram installment reminder bot for Sablo (Telegraf) — port of the Rubika bot",
  "main": "server.js",
  "engines": { "node": ">=18" },
  "scripts": {
